{
    "name": "karnoweb/livewire-datepicker",
    "description": "Jalali/Gregorian datepicker for Livewire 3 & 4 with Alpine.js",
    "keywords": ["laravel","livewire","datepicker","jalali","persian","alpine"],
    "license": "MIT",
    "version": "13.0.0",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^3.0 || ^4.0",
        "morilog/jalali": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "Karnoweb\\LivewireDatepicker\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karnoweb\\LivewireDatepicker\\DatepickerServiceProvider"
            ]
        }
    },
    "prefer-stable": true
    
}
